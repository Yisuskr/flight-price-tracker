# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your real values.
# NEVER commit .env to git (it is in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── SerpAPI (Google Flights) ──────────────────────────────────────────────────
# Get your free key at https://serpapi.com/  (100 free searches/month)
SERPAPI_KEY=

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# The Gmail account that will SEND the alert emails.
# Use an App Password, NOT your regular Gmail password.
# How to create an App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create a new app password → select "Mail" / "Other (custom name)"
#   5. Copy the 16-character password below (no spaces)
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password_here

# ── Kiwi.com / Tequila API (optional, 500 free calls/month) ──────────────────
# Sign up at https://tequila.kiwi.com/  →  Portal → My API keys
# Leave blank to disable this source.
KIWI_API_KEY=

# ── Skyscanner via RapidAPI (optional, ~50 free calls/month) ─────────────────
# Subscribe at https://rapidapi.com/3b-data-3b-data-default/api/skyscanner44
# Leave blank to disable this source.
RAPIDAPI_KEY=

# ── Aviasales / Travelpayouts (optional, no declared limit) ──────────────────
# Get your token at https://app.travelpayouts.com/profile/api-token
# Leave blank to disable this source.
AVIASALES_TOKEN=
