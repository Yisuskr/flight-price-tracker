# Copy this file to .env and fill in your real values.
# Never commit .env. It is ignored by Git.

# Email delivery.
# Use "sendgrid" for hosted 24/7 deployments, or "smtp" for local Gmail.
EMAIL_PROVIDER=sendgrid

# SendGrid mode: good for Render/Railway/Fly/etc. because it uses HTTPS.
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMTP/Gmail mode: good for local use from your own computer.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

SENDER_EMAIL=verified_sender@example.com
SENDER_NAME=Flight Tracker

# Flight data sources.
# Fill at least one source key. Leave blank to disable a source.

# Google Flights via SerpAPI: https://serpapi.com/
SERPAPI_KEY=

# Kiwi.com Tequila API: https://tequila.kiwi.com/
KIWI_API_KEY=

# Skyscanner via RapidAPI:
# https://rapidapi.com/3b-data-3b-data-default/api/skyscanner44
RAPIDAPI_KEY=

# Aviasales / Travelpayouts:
# https://app.travelpayouts.com/profile/api-token
AVIASALES_TOKEN=
